@@ -0,0 +1,53 @@
+//! MEASUREMENT ONLY (scripts/scroll-pixel-memory.patch, m8 04): counts large
+//! allocations and appends one line per pixel frame to `MWR_MEM_STATS`.
+//! Never committed to the source tree; the script applies it to a scratch
+//! worktree.
+
+use std::io::Write;
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::Instant;
+
+/// macOS malloc serves requests above 127 KiB from its large allocator
+/// (`Malloc Large` in vmmap); every strip-sized buffer is one. The counting
+/// allocator itself is in `main.rs` (this crate forbids `unsafe`).
+pub const LARGE: usize = 127 * 1024;
+
+pub static LARGE_ALLOCS: AtomicU64 = AtomicU64::new(0);
+pub static LARGE_BYTES: AtomicU64 = AtomicU64::new(0);
+
+/// Count one allocation of `size` bytes if it is large.
+pub fn count(size: usize) {
+    if size > LARGE {
+        LARGE_ALLOCS.fetch_add(1, Ordering::Relaxed);
+        LARGE_BYTES.fetch_add(size as u64, Ordering::Relaxed);
+    }
+}
+
+static START: OnceLock<Instant> = OnceLock::new();
+
+/// Start the clock; called first thing in `main`.
+pub fn start() {
+    START.get_or_init(Instant::now);
+}
+
+/// Append `fields` after the elapsed time and the allocation counters.
+pub fn line(fields: &str) {
+    let Some(path) = std::env::var_os("MWR_MEM_STATS") else {
+        return;
+    };
+    let ms = START.get().map_or(0, |start| start.elapsed().as_millis());
+    let text = format!(
+        "t_ms={ms} large_allocs={} large_mb={} {fields}\n",
+        LARGE_ALLOCS.load(Ordering::Relaxed),
+        LARGE_BYTES.load(Ordering::Relaxed) >> 20,
+    );
+    if let Ok(mut file) = std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(path)
+    {
+        // Measurement only: a lost line shows as a gap in the file.
+        let _ = file.write_all(text.as_bytes());
+    }
+}
